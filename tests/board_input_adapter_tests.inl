void test_board_input_adapters() {
    qa_capture=true;qa_board_modifier=0x100;qa_active=qa_focus=true;qa_menu=qa_spectator=false;
    originals[0]=input;sample={};sample.Gamepad.wButtons=0x100;sample.Gamepad.sThumbRX=23000;sample.Gamepad.sThumbRY=-17000;
    XINPUT_STATE output{};filtered_state<0>(0,&output);
    check(!output.Gamepad.sThumbRX && !output.Gamepad.sThumbRY,"on-board Xbox modifier leaked trick axes");
    sample.Gamepad.wButtons=0;filtered_state<0>(0,&output);
    check(output.Gamepad.sThumbRX==23000 && output.Gamepad.sThumbRY==-17000,"Xbox modifier release did not restore axes immediately");
    qa_native_axes={.5f,-.75f};sample.Gamepad.wButtons=0x100;filtered_state<0>(0,&output);
    check(output.Gamepad.sThumbRX==stick_short(.5f) && output.Gamepad.sThumbRY==stick_short(-.75f),"Xbox did not hold latched skating input");
    sample.Gamepad.sThumbRX=-31000;sample.Gamepad.sThumbRY=27000;filtered_state<0>(0,&output);
    check(output.Gamepad.sThumbRX==stick_short(.5f) && output.Gamepad.sThumbRY==stick_short(-.75f),"camera movement changed latched Xbox input");
    const auto packet=output.dwPacketNumber;qa_native_axes={-.25f,.25f};filtered_state<0>(0,&output);
    check(output.dwPacketNumber!=packet,"changed native override kept stale Xbox packet number");
    sample.Gamepad.wButtons=0;filtered_state<0>(0,&output);
    check(output.Gamepad.sThumbRX==-31000 && output.Gamepad.sThumbRY==27000,"held Xbox input did not snap to current axes on release");
    qa_native_axes={};
    std::array<std::uint8_t,64> report{};report[0]=1;report[3]=210;report[4]=150;report[8]=8;report[9]=1;
    filter_sony_report(3,40,dingosdk::PlayStationPad::dualsense,report,true,0x100);
    check(report[3]==128 && report[4]==128,"native Sony modifier leaked stick axes");
    report[3]=210;report[4]=150;report[9]=0;
    filter_sony_report(3,40,dingosdk::PlayStationPad::dualsense,report,true,0x100);
    check(report[3]==210 && report[4]==150,"Sony modifier release failed to restore axes");
    report[9]=1;filter_sony_report(3,41,dingosdk::PlayStationPad::dualsense,report,true,{0x100,{.5f,-.75f}});
    check(report[3]==192 && report[4]==222 && report[9]==1,"Sony held axes altered modifier or used wrong encoding");
    report[9]=0;report[3]=30;report[4]=240;
    filter_sony_report(3,41,dingosdk::PlayStationPad::dualsense,report,true,{0x100,{.5f,-.75f}});
    check(report[3]==30 && report[4]==240,"Sony held-axis release did not pass physical input verbatim");
    // Spectator capture is valid while local First Person and local glances
    // are inactive. It must still reach Sony and DirectInput adapters.
    qa_spectator=true;qa_active=false;toggle_eligible=false;
    report[9]=1;report[3]=210;report[4]=150;
    filter_sony_report(3,42,dingosdk::PlayStationPad::dualsense,report);
    check(report[3]==128 && report[4]==128,"spectator Sony modifier leaked native camera stick axes");
    std::array<void*,32> table{};table[5]=reinterpret_cast<void*>(&fake_direct_property);table[14]=reinterpret_cast<void*>(&fake_direct_object);
    table[9]=reinterpret_cast<void*>(&direct_state<0>);
    direct_hooks[di_state][0].original=reinterpret_cast<void*>(&fake_direct_state);
    direct_hooks[di_data][0].original=reinterpret_cast<void*>(&fake_direct_data);
    FakeDirect device;device.table=table.data();device.axes=true;
    device.physical[device.l1]=0x80;DWORD hat=0xffffffffu;std::memcpy(device.physical.data()+device.pov,&hat,4);
    LONG axis=60000;std::memcpy(device.physical.data()+offsetof(DIJOYSTATE,lZ),&axis,4);
    std::memcpy(device.physical.data()+offsetof(DIJOYSTATE,lRz),&axis,4);
    dingosdk::FirstPersonLookControls bindings{};publish_glance_filter(bindings,true,{1,2,3,4},0x100);
    std::array<unsigned char,sizeof(DIJOYSTATE2)> data{};
    direct_state<0>(&device,sizeof(DIJOYSTATE2),data.data());LONG x{},y{};
    std::memcpy(&x,data.data()+offsetof(DIJOYSTATE,lZ),4);std::memcpy(&y,data.data()+offsetof(DIJOYSTATE,lRz),4);
    check(x==32767 && y==32767 && data[device.l1]==0x80,"DirectInput modifier did not neutralize only right stick");
    device.physical[device.l1]=0;direct_state<0>(&device,sizeof(DIJOYSTATE2),data.data());
    std::memcpy(&x,data.data()+offsetof(DIJOYSTATE,lZ),4);check(x==60000,"DirectInput release failed to restore axes");
    qa_native_axes={.5f,-.75f};device.physical[device.l1]=0x80;
    direct_state<0>(&device,sizeof(DIJOYSTATE2),data.data());
    std::memcpy(&x,data.data()+offsetof(DIJOYSTATE,lZ),4);std::memcpy(&y,data.data()+offsetof(DIJOYSTATE,lRz),4);
    check(x==49151 && y==57343,"DirectInput native held input ignored range or Y direction");
    qa_native_axes={};device.physical[device.l1]=0;
    auto& state=direct_devices[&device];state.buffered_known=true;state.buffered_buttons=0x100;
    device.queued={{offsetof(DIJOYSTATE,lZ),60000,1,1,0},{device.l1,0,2,2,0},{offsetof(DIJOYSTATE,lRz),60000,3,3,0}};
    std::array<DIDEVICEOBJECTDATA,3> events{};DWORD count=3;
    direct_data<0>(&device,sizeof(DIDEVICEOBJECTDATA),events.data(),&count,0);
    check(count==3 && events[0].dwData==32767 && events[2].dwData==60000,"buffered DirectInput axes ignored modifier release ordering");
    // Stationary sticks produce no axis event at release: inject both current axes.
    state.stick_captured=true;state.buffered_buttons=0x100;
    device.queued={{device.l1,0,10,10,0}};
    std::array<DIDEVICEOBJECTDATA,8> snap{};count=8;
    direct_data<0>(&device,sizeof(DIDEVICEOBJECTDATA),snap.data(),&count,DIGDD_PEEK);
    check(count==3 && snap[1].dwData==60000 && snap[2].dwData==60000,"stationary DirectInput release left held axes stale");
    count=8;direct_data<0>(&device,sizeof(DIDEVICEOBJECTDATA),snap.data(),&count,DIGDD_PEEK);
    check(count==3 && state.restore_axes.size()==2,"peek consumed or duplicated pending snap axes");
    count=8;direct_data<0>(&device,sizeof(DIDEVICEOBJECTDATA),snap.data(),&count,0);
    check(count==3 && state.restore_axes.empty(),"non-peek failed to deliver pending snap axes");
    state.stick_captured=true;state.buffered_buttons=0x100;
    device.queued={{device.l1,0,20,20,0}};count=1;
    direct_data<0>(&device,sizeof(DIDEVICEOBJECTDATA),snap.data(),&count,0);
    check(count==1 && state.restore_axes.size()==2,"small event buffer lost release position");
    count=8;direct_data<0>(&device,sizeof(DIDEVICEOBJECTDATA),snap.data(),&count,0);
    check(count==2 && snap[0].dwData==60000 && snap[1].dwData==60000,"queued snap did not deliver in next available buffer");
    qa_panel=true;sample.Gamepad.wButtons=0x1101;sample.Gamepad.sThumbLX=20000;sample.Gamepad.bRightTrigger=255;
    filtered_state<0>(0,&output);
    check(output.Gamepad.wButtons==0 && output.Gamepad.sThumbLX==0 && output.Gamepad.bRightTrigger==0,"open independent menu leaked Xbox gameplay input");
    raw_controller_read=true;filtered_state<0>(0,&output);raw_controller_read=false;
    check(output.Gamepad.wButtons==0x1101 && output.Gamepad.sThumbLX==20000,"menu's private Xbox reader was blocked");
    report[3]=210;report[4]=150;report[8]=0x20;report[9]=1;report[5]=255;report[6]=255;
    filter_sony_report(3,45,dingosdk::PlayStationPad::dualsense,report);
    check(report[3]==128 && report[4]==128 && report[8]==8 && report[9]==0 && report[5]==0,"independent menu leaked native Sony gameplay input");
    device.physical[device.l1]=0x80;direct_state<0>(&device,sizeof(DIJOYSTATE2),data.data());
    std::memcpy(&x,data.data()+offsetof(DIJOYSTATE,lZ),4);
    check(data[device.l1]==0 && x==32767,"independent menu leaked DirectInput buttons or axes");
    qa_panel=false;qa_capture=false;qa_board_modifier=0;qa_active=true;qa_spectator=false;clear_glance_filter();direct_devices.clear();
}
